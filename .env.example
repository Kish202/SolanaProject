# --- Server ---
PORT=8080
LOG_LEVEL=info
NODE_ENV=development
# Protects /v1/admin/* endpoints (header: x-admin-key). Use a long random value.
ADMIN_API_KEY=change-me-to-a-long-random-string
# Browser origins allowed to call the API (your Vercel URL in production), comma separated
CORS_ORIGINS=http://localhost:3000

# --- Datastores ---
# Supabase: Dashboard -> Connect -> "Session pooler" (IPv4, works from Render/AWS/your laptop).
# Replace [YOUR-PASSWORD] with the database password you set when creating the project.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# disable (local Postgres) | require (TLS) | verify (TLS + certificate check, needs DATABASE_SSL_CA)
DATABASE_SSL=require
# Optional: contents of the Supabase CA certificate (Dashboard -> Database -> SSL Configuration), with \n for newlines
DATABASE_SSL_CA=
# Optional. Leave unset to use in-memory Redis (single instance only).
# Local Redis via Homebrew: `brew install redis && brew services start redis`
REDIS_URL=redis://localhost:6379

# --- Solana ---
# Use devnet while developing. For mainnet use a paid RPC provider (Helius, Triton, QuickNode).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Optional extra RPC endpoints used only for rebroadcasting (comma separated)
SOLANA_SEND_RPC_URLS=
SOLANA_COMMITMENT=confirmed

# Base58 secret key of the gas sponsor (fee payer) wallet. Generate with: npm run gen:sponsor-key
# In production this comes from AWS Secrets Manager / KMS, never from a file in git.
SPONSOR_SECRET_KEY=

# --- Jupiter ---
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_PRICE_URL=https://lite-api.jup.ag/price/v3
# Optional: a key from portal.jup.ag raises rate limits. Use it with the keyed host
# (https://api.jup.ag/swap/v1 and https://api.jup.ag/price/v3) instead of lite-api.
# JUPITER_API_KEY=

# --- Fees ---
# Platform fee charged on each swap, in basis points (100 bps = 1%)
PLATFORM_FEE_BPS=50
# Owner wallet of the platform fee token accounts (Jupiter sends the fee to the ATA of this owner for the output mint)
PLATFORM_FEE_OWNER=

# --- Sponsorship guardrails ---
SPONSOR_MAX_TX_PER_WALLET_PER_HOUR=30
SPONSOR_DAILY_BUDGET_LAMPORTS=2000000000
PRIORITY_FEE_MAX_LAMPORTS=200000

# --- Price pipeline ---
# Comma separated mints to stream prices for (default: SOL, USDC, JUP)
PRICE_MINTS=So11111111111111111111111111111111111111112,EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v,JUPyiwrYJFskUPiHa7hkeR8VUtAeFoSYbKedZNsDvCN
PRICE_POLL_MS=10000
